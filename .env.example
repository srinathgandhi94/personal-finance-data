# Copy this file to .env and fill in your actual values
# The .env file is gitignored, so your secrets won't be committed

# Google Sheets service account JSON path (relative to project root or absolute)
GOOGLE_CREDENTIALS_PATH=Creds/creds.json

# Sheet IDs (from the spreadsheet URL: .../d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID_PORTFOLIO=your_portfolio_sheet_id
GOOGLE_SHEET_ID_INVESTMENT_REPORT=your_investment_report_sheet_id

# PostgreSQL connection URL
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname

# File paths (absolute paths recommended on Windows)
WALLET_REPORT_FILE=C:\path\to\Wallet Report.xlsx
